DEEPSEEK_API_KEY=sk-your-key-here

# Model + provider. deepseek-chat ĐÃ BỊ KHAI TỬ (gọi vào là HTTP 400) — để trống
# thì dùng deepseek-v4-pro.
# LLM_MODEL=deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com

# true = chạy ẩn (không thấy cửa sổ Chrome); để trống hoặc false khi cần tự đăng nhập thủ công
BROWSER_HEADLESS=false

# === Ba biến dưới đây THƯỜNG KHÔNG CẦN ĐỘNG TỚI ===
# Mặc định đã trỏ đúng chỗ companion app dùng, nên đăng nhập một lần là cả CLI lẫn
# app đều chạy được. Chỉ set khi muốn tách riêng.
#
# Profile Chrome thật của agent — nơi phiên đăng nhập thực sự sống, Chromium tự
# giữ và tự gia hạn cookie/localStorage/IndexedDB trong đó.
#   mặc định: %APPDATA%/PersonalAgent/browser-profile
# BROWSER_USER_DATA_DIR=
#
# Bản sao lưu phiên dạng JSON (Playwright storageState). Chỉ là bản dự phòng —
# khi đã dùng profile thì file này KHÔNG được nạp lại. Đừng trỏ nó vào chỗ riêng
# của agent-framework: bản của CLI và của app sẽ trôi khỏi nhau và đánh lừa người
# đi kiểm tra (đo 01-08-2026: file cũ còn là phiên 18-07 đã chết).
#   mặc định: %APPDATA%/PersonalAgent/state.json
# BROWSER_STORAGE_STATE=
#
# Nơi lưu file tải về.
#   mặc định: ~/Downloads/PersonalAgent
# BROWSER_DOWNLOADS_DIR=
