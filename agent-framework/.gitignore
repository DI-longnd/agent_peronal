# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
# Bản sao lưu .env cũng chứa API key — `.env` không khớp `.env.bak`, `.env.local`...
.env.*
!.env.example

# Browser storage state (chứa cookie/session đăng nhập thật — không commit)
.auth/

# Ghi chú agent tự viết lúc chạy (write_note) — dữ liệu của từng lượt chạy,
# không phải mã nguồn. Giữ thư mục, bỏ nội dung.
memory/notes/*
!memory/notes/.gitkeep
